// Mirrors database.md (§4.1 identity, §4.4 supporting). Conventions:
// models PascalCase + @@map(snake_case), fields camelCase + @map(snake_case),
// uuid PKs default to Postgres 18 uuidv7(), all timestamps timestamptz.
// CHECK constraints, partial indexes and extensions live in the migration SQL.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum UserRole {
  attendee
  organizer
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

enum OrgVerification {
  pending
  verified
  rejected

  @@map("org_verification")
}

enum UploadPurpose {
  event_cover
  organizer_logo

  @@map("upload_purpose")
}

enum UploadStatus {
  pending
  processing
  ready
  failed

  @@map("upload_status")
}

enum EventMode {
  in_person
  online
  hybrid

  @@map("event_mode")
}

enum SeatingType {
  general_admission
  reserved

  @@map("seating_type")
}

enum EventStatus {
  draft
  published
  cancelled
  completed

  @@map("event_status")
}

enum EventVisibility {
  public
  unlisted
  private

  @@map("event_visibility")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  expired
  refunded
  partially_refunded

  @@map("booking_status")
}

enum TicketStatus {
  valid
  checked_in
  cancelled
  refunded

  @@map("ticket_status")
}

enum StaffRole {
  manager
  scanner

  @@map("staff_role")
}

enum TokenPurpose {
  email_verify
  password_reset

  @@map("token_purpose")
}

enum NotificationChannel {
  email
  sms

  @@map("notification_channel")
}

enum NotificationStatus {
  queued
  sent
  failed

  @@map("notification_status")
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  phone           String?
  role            UserRole   @default(attendee)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  sessions           AuthSession[]
  verificationTokens VerificationToken[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  organizerProfile   OrganizerProfile?
  uploads            Upload[]
  bookings           Booking[]
  staffOf            EventStaff[]        @relation("StaffMember")
  checkIns           Ticket[]            @relation("CheckedInBy")

  @@map("users")
}

/// One row per logged-in device. `expiresAt` is the absolute cap (SESSION_MAX_DAYS).
model AuthSession {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

/// Rotating refresh-token chain per session. Only sha256(token) is stored.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Email verification and password reset. Only sha256(token) is stored.
model VerificationToken {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz
  usedAt    DateTime?    @map("used_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ───────────────────────── Supporting ─────────────────────────

/// Transactional outbox: written in the same transaction as the state change, sent by the worker.
model Notification {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String?             @map("user_id") @db.Uuid
  type              String
  channel           NotificationChannel @default(email)
  recipient         String
  payload           Json                @default("{}")
  status            NotificationStatus  @default(queued)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error")
  providerMessageId String?             @map("provider_message_id")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}

/// Append-only record of privileged / security-relevant actions.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  diff       Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ───────────────────────── Catalog ─────────────────────────

/// Two levels max: top-level categories and their sub-categories (enforced in the service).
model Category {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String   @unique @db.Citext
  slug      String   @unique @db.Citext
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  events   Event[]

  @@index([parentId])
  @@map("categories")
}

/// One-to-one with a user who became an organizer. `payoutDetails` is AES-256-GCM ciphertext.
model OrganizerProfile {
  userId             String          @id @map("user_id") @db.Uuid
  orgName            String          @map("org_name")
  slug               String          @unique @db.Citext
  bio                String?
  logoUrl            String?         @map("logo_url")
  website            String?
  verificationStatus OrgVerification @default(pending) @map("verification_status")
  reviewNote         String?         @map("review_note")
  reviewedAt         DateTime?       @map("reviewed_at") @db.Timestamptz
  payoutMethod       String?         @map("payout_method")
  payoutDetails      Json?           @map("payout_details")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
  venues Venue[]

  @@index([verificationStatus, createdAt(sort: Desc)])
  @@map("organizer_profiles")
}

/// Seat maps (venue_seats) come later with reserved seating.
model Venue {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId     String?   @map("owner_id") @db.Uuid /// NULL = platform-managed venue
  name        String
  addressLine String?   @map("address_line")
  city        String
  country     String    @default("Nepal")
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  capacity    Int?
  hasSeatMap  Boolean   @default(false) @map("has_seat_map")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  owner  OrganizerProfile? @relation(fields: [ownerId], references: [userId], onDelete: Restrict)
  events Event[]

  @@index([ownerId])
  @@map("venues")
}

/// Image uploaded straight to object storage, then validated + resized by the media worker.
model Upload {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  purpose     UploadPurpose
  status      UploadStatus  @default(pending)
  contentType String        @map("content_type")
  sizeBytes   Int           @map("size_bytes")
  objectKey   String        @map("object_key") /// tmp/{id}: raw upload, deleted after processing
  variants    Json? /// { "lg": "https://…/lg.webp", "md": …, "sm": … } once ready
  width       Int?
  height      Int?
  error       String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverEvents Event[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("uploads")
}

model Event {
  id                 String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizerId        String                   @map("organizer_id") @db.Uuid
  venueId            String?                  @map("venue_id") @db.Uuid
  categoryId         String?                  @map("category_id") @db.Uuid
  title              String
  slug               String                   @unique @db.Citext
  summary            String?
  description        String?
  coverUploadId      String?                  @map("cover_upload_id") @db.Uuid
  mode               EventMode
  onlineUrl          String?                  @map("online_url")
  seatingType        SeatingType              @default(general_admission) @map("seating_type")
  startsAt           DateTime                 @map("starts_at") @db.Timestamptz
  endsAt             DateTime                 @map("ends_at") @db.Timestamptz
  timezone           String                   @default("Asia/Kathmandu")
  status             EventStatus              @default(draft)
  visibility         EventVisibility          @default(public)
  publishedAt        DateTime?                @map("published_at") @db.Timestamptz
  cancelledAt        DateTime?                @map("cancelled_at") @db.Timestamptz
  cancellationReason String?                  @map("cancellation_reason")
  metadata           Json                     @default("{}")
  /// GENERATED ALWAYS … STORED (see migration); never written by the app
  searchVector       Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('simple'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(summary, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(description, ''::text)), 'C'::\"char\"))")) @map("search_vector")
  version            Int                      @default(0)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz

  organizer   OrganizerProfile @relation(fields: [organizerId], references: [userId], onDelete: Restrict)
  venue       Venue?           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cover       Upload?          @relation(fields: [coverUploadId], references: [id], onDelete: SetNull)
  ticketTypes TicketType[]
  bookings    Booking[]
  tickets     Ticket[]
  eventStaffs EventStaff[]

  @@index([organizerId, createdAt(sort: Desc)])
  @@index([categoryId, startsAt])
  @@index([venueId])
  @@index([searchVector], map: "events_search_idx", type: Gin)
  @@map("events")
}

/// Ticket tiers. Stock is reserved/sold with atomic conditional UPDATEs (bookings module).
model TicketType {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  name             String
  description      String?
  price            BigInt /// minor units (paisa); 0 = free
  currency         String    @default("NPR") @db.Char(3)
  quantityTotal    Int       @map("quantity_total")
  quantityReserved Int       @default(0) @map("quantity_reserved")
  quantitySold     Int       @default(0) @map("quantity_sold")
  minPerOrder      Int       @default(1) @map("min_per_order")
  maxPerOrder      Int       @default(10) @map("max_per_order")
  salesStartAt     DateTime? @map("sales_start_at") @db.Timestamptz
  salesEndAt       DateTime? @map("sales_end_at") @db.Timestamptz
  isActive         Boolean   @default(true) @map("is_active")
  sortOrder        Int       @default(0) @map("sort_order")
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]
  tickets      Ticket[]

  @@unique([eventId, name])
  @@map("ticket_types")
}

/// An order. Stock is held (quantity_reserved) while pending; confirmed moves it to quantity_sold.
model Booking {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingCode    String        @unique @map("booking_code")
  userId         String        @map("user_id") @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  status         BookingStatus @default(pending)
  subtotal       BigInt
  discountAmount BigInt        @default(0) @map("discount_amount")
  feeAmount      BigInt        @default(0) @map("fee_amount")
  totalAmount    BigInt        @map("total_amount")
  currency       String        @db.Char(3)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz
  idempotencyKey String?       @map("idempotency_key")
  contactEmail   String        @map("contact_email")
  contactPhone   String?       @map("contact_phone")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items BookingItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([eventId, status])
  @@map("bookings")
}

model BookingItem {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId    String @map("booking_id") @db.Uuid
  ticketTypeId String @map("ticket_type_id") @db.Uuid
  quantity     Int
  unitPrice    BigInt @map("unit_price") /// price snapshot at booking time
  lineTotal    BigInt @map("line_total")

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@unique([bookingId, ticketTypeId])
  @@map("booking_items")
}

/// One row per admission, issued when the booking is confirmed. ticket_code is encoded in the QR.
model Ticket {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketCode     String       @unique @map("ticket_code")
  bookingItemId  String       @map("booking_item_id") @db.Uuid
  eventId        String       @map("event_id") @db.Uuid
  ticketTypeId   String       @map("ticket_type_id") @db.Uuid
  holderName     String?      @map("holder_name")
  holderEmail    String?      @map("holder_email")
  status         TicketStatus @default(valid)
  checkedInAt    DateTime?    @map("checked_in_at") @db.Timestamptz
  checkedInBy    String?      @map("checked_in_by") @db.Uuid
  pdfKey         String?      @map("pdf_key") /// private object key, set by the tickets worker
  pdfGeneratedAt DateTime?    @map("pdf_generated_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Restrict)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType  TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  scanner     User?       @relation("CheckedInBy", fields: [checkedInBy], references: [id], onDelete: SetNull)

  @@index([bookingItemId])
  @@index([eventId, status])
  @@map("tickets")
}

/// Who may scan tickets (scanner) or help run an event (manager).
model EventStaff {
  eventId   String    @map("event_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      StaffRole
  addedBy   String?   @map("added_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("StaffMember", fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_staff")
}
