# ---- Runtime ----
NODE_ENV=development
PROCESS_TYPE=api
APP_VERSION=dev
APP_NAME=EMS
PORT=3000
LOG_LEVEL=debug
TRUST_PROXY=loopback
# comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- Database (PostgreSQL 18) ----
# pooled URL used by the app (PgBouncer in prod)
DATABASE_URL=postgres://ems:ems@localhost:5432/ems
# direct, non-pooled URL used by `prisma migrate`
DIRECT_URL=postgres://ems:ems@localhost:5432/ems
DB_POOL_MAX=10

# ---- Redis 8 (cache, rate limits, BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Ed25519 key pair, PEM on one line with \n. Generate with: npm run keys:generate -- --write
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev-1
JWT_ISSUER=ems-api
JWT_AUDIENCE=ems-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_DAYS=90
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ---- Encryption at rest (payout details) ----
# 32 bytes as hex. Generate with: npm run keys:generate -- --write
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
# Retired keys kept for decrypting old rows, "id:hex,id:hex"
DATA_ENCRYPTION_OLD_KEYS=

# ---- Email ----
# smtp = Mailpit locally (UI http://localhost:8025) | resend = staging/prod | console = tests
EMAIL_DRIVER=smtp
EMAIL_FROM="EMS <no-reply@ems.local>"
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# ---- Business rules ----
BOOKING_HOLD_MINUTES=10
