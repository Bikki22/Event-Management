# ---- Runtime ----
NODE_ENV=development
PROCESS_TYPE=api
APP_VERSION=dev
APP_NAME=EMS
PORT=3000
LOG_LEVEL=debug
TRUST_PROXY=loopback
# comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- Database (PostgreSQL 18) ----
# pooled URL used by the app (PgBouncer in prod)
DATABASE_URL=postgres://ems:ems@localhost:5432/ems
# direct, non-pooled URL used by `prisma migrate`
DIRECT_URL=postgres://ems:ems@localhost:5432/ems
DB_POOL_MAX=10

# ---- Redis 8 (cache, rate limits, BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Ed25519 key pair, PEM on one line with \n. Generate with: npm run keys:generate -- --write
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev-1
JWT_ISSUER=ems-api
JWT_AUDIENCE=ems-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_DAYS=90
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ---- Encryption at rest (payout details) ----
# 32 bytes as hex. Generate with: npm run keys:generate -- --write
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
# Retired keys kept for decrypting old rows, "id:hex,id:hex"
DATA_ENCRYPTION_OLD_KEYS=

# ---- Object storage (S3 API) ----
# Local: RustFS from docker-compose (console http://localhost:9001, login ems / ems-storage-secret)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ems-media
S3_ACCESS_KEY_ID=ems
S3_SECRET_ACCESS_KEY=ems-storage-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/ems-media
UPLOAD_MAX_BYTES=5242880

# ---- Email ----
# smtp = Mailpit locally (UI http://localhost:8025) | resend = staging/prod | console = tests
EMAIL_DRIVER=smtp
EMAIL_FROM="EMS <no-reply@ems.local>"
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# ---- Business rules ----
BOOKING_HOLD_MINUTES=10

# ---- Payments ----
# Frontend page gateways redirect back to; it calls POST /api/v1/payments/{provider}/verify
PAYMENT_RETURN_URL=http://localhost:5173/payments/return
# Khalti sandbox: create a merchant at https://test-admin.khalti.com and paste the live secret key of that test account
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# eSewa UAT (public test credentials from the eSewa developer docs)
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Stripe test mode: sk_test_... and the whsec_... from `stripe listen` / the dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fake gateway for local testing (never in production)
PAYMENT_MOCK_ENABLED=true
# Buyers can refund themselves until this many hours before the event
REFUND_CUTOFF_HOURS=48

# ---- Metrics ----
# Bearer token for GET /metrics (optional; without it only local/private IPs may scrape)
METRICS_TOKEN=
